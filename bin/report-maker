#!/usr/bin/env python3
"""report-maker — run the engine from anywhere.

Symlink this onto your PATH:

    ln -s "$PWD/bin/report-maker" ~/.local/bin/report-maker

It adds the engine's parent directory to sys.path, so no install step and no
virtualenv are needed — the engine has no third-party dependencies.
"""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from engine.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
